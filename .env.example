# Скопируйте в .env и заполните. .env не коммитится.

BOT_TOKEN=
# PostgreSQL с pgvector. Через docker compose: postgresql://assistant:ПАРОЛЬ@localhost:5433/assistant
DATABASE_URL=
POSTGRES_PASSWORD=
# Redis для состояний диалогов (рассылка в админке); пусто — в памяти
REDIS_URL=
# Telegram ID админов через запятую
ADMIN_IDS=

# --- Модели ---
# gemini | anthropic | openai (openai — также OpenRouter, DeepSeek, Ollama через OPENAI_BASE_URL)
LLM_PROVIDER=gemini
MODEL_FAST=gemini-flash-latest
MODEL_SMART=gemini-pro-latest
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Эмбеддинги для памяти и документов: gemini | openai
EMBED_PROVIDER=gemini
EMBED_MODEL=gemini-embedding-001
# Кто расшифровывает голосовые: gemini | openai (Claude аудио не принимает)
STT_PROVIDER=gemini
# Цена модели, $ за 1 млн токенов [вход, выход] — для учёта себестоимости в /admin
PRICE_FAST=[0.3, 2.5]
PRICE_SMART=[1.25, 10.0]

# Поиск в интернете (tavily.com, бесплатно 1000 запросов/мес); пусто — выключен
TAVILY_API_KEY=

# --- Тарифы ---
FREE_MESSAGES=20
FREE_FILES=3
PRO_MESSAGES=300
PRO_FILES=50
PRO_DAYS=30
PRO_PRICE_STARS=250
PRO_PRICE_RUB=399
# Провайдер карт из @BotFather → Payments (ЮKassa); пусто — только Telegram Stars
PAYMENT_TOKEN=

DEFAULT_TIMEZONE=Europe/Moscow
# Вебхук вместо polling: публичный HTTPS-адрес и секрет (openssl rand -hex 32)
WEBHOOK_URL=
WEBHOOK_SECRET=
# false — не подключаться к Telegram (локальная разработка, пока бот работает на сервере)
POLLING=true
HOST=127.0.0.1
PORT=8090
